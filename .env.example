# Banco de Dados MySQL / MariaDB (XAMPP)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=monitoramento_precos

# Google Sheets & Google BigQuery
GOOGLE_SPREADSHEET_ID=SEU_SPREADSHEET_ID_AQUI
GCP_PROJECT_ID=seu-projeto-gcp
BIGQUERY_DATASET=radar_precos

# Bot do Telegram para Disparo de Alertas de Oferta Boa
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Para receber LIGAÇÃO DE VOZ no Telegram na madrugada (02h-06h59):
TELEGRAM_CALL_USER=
SLEEP_START_HOUR=2
SLEEP_END_HOUR=6

# Configurações do Motor de Decisão
ALERT_MIN_SCORE=70
ALERT_COOLDOWN_HOURS=12
ALERT_EXTRA_DROP_RS=30.0
